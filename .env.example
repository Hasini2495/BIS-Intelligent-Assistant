# =============================================================================
# BIS Intelligent Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values. Never commit .env to git.
# =============================================================================

# ── Frontend (Vite — only VITE_* vars are exposed to the browser) ──
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCKS=true
VITE_APP_TITLE=BIS Intelligent Assistant
VITE_DEMO_MODE=true

# ── Backend ──
BACKEND_ENV=development
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# ── Database ──
DATABASE_URL=sqlite:///./data/bis_assistant.db

# ── LLM Provider (optional — app works in demo mode without these) ──
LLM_PROVIDER=demo
# Options: demo | gemini | sarvam
GEMINI_API_KEY=
SARVAM_API_KEY=

# ── Retrieval / Embedding (optional) ──
EMBEDDING_PROVIDER=demo
EMBEDDING_MODEL=

# ── Security ──
SECRET_KEY=change-me-to-a-random-string-in-production
